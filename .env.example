# Environment variables must use APP_ prefix to override config.yaml
# Format: APP_<SECTION>_<KEY> (e.g., APP_DATABASE_PASSWORD)

# Server Configuration
APP_SERVER_PORT=8080
APP_SERVER_HOST=0.0.0.0
APP_SERVER_MODE=debug

# Database Configuration
APP_DATABASE_DRIVER=mysql
APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=3306
APP_DATABASE_USER=root
APP_DATABASE_PASSWORD=password
APP_DATABASE_DBNAME=go_clean_arch
APP_DATABASE_SSLMODE=disable
APP_DATABASE_AUTO_MIGRATE=true

# RabbitMQ Configuration
APP_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
APP_RABBITMQ_QUEUE_NAME=order_queue

# Cron Configuration
APP_CRON_DAILY_REPORT_SCHEDULE=0 0 * * *

# Stripe Configuration
APP_STRIPE_API_KEY=your-stripe-api-key
APP_STRIPE_SECRET_KEY=your-stripe-secret-key
